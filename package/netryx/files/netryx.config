config netryx 'main'
	# The bridges whose traffic is observed. Every device on them is seen; a
	# bridge left out is invisible, which is the honest way to exclude one.
	list interface 'br-lan'
	# Where the packets are selected.
	#
	#   ingress - at the bridge's member devices, before anything can offload
	#             the flow away from the CPU. Identity comes from the frame:
	#             the device's own hardware address, and an address that has
	#             not been through NAT.
	#   forward - in the forward hook, which attaches the connection and so
	#             counts a connection's packets exactly. It sees nothing once
	#             flow offloading is turned on, and nothing reports that.
	option mode 'ingress'
	# Set to 0 to publish only what the kernel's connection table says, with
	# no rule installed and no packet read.
	option capture '1'
	# Read the questions devices ask this router's resolver, and the answers it
	# gives them. It is the only naming that still works when a browser
	# encrypts the name inside the handshake, and it is also the most personal
	# thing netryx looks at: a list of names is a list of interests. Set to 0
	# to see only what the handshakes give up.
	option passive_dns '1'
	# The netfilter log group the first packets of each connection are copied
	# to, a number from 0 to 65535. Change it only if another program (ulogd,
	# an IDS) already reads 7.
	option log_group '7'
	# Where the dashboard listens. Loopback by default: publishing it is a
	# decision, not an accident. Every page and every API route needs the
	# router's LuCI login; without rpcd no login is possible, and the console
	# stays on loopback whatever is written here. For the house network write
	# the LAN address (192.168.1.1:8788). 0.0.0.0 takes in the WAN address too;
	# a request arriving on an address outside the house is then refused.
	option listen '127.0.0.1:8788'
	# On a house-side address the console is served over https with these,
	# uhttpd's own certificate and key, when both exist. Without them it makes
	# a self-signed certificate of its own once (/etc/netryx/console.crt, the
	# key root's alone) and keeps it, so the browser asks to accept it once.
	# A tunnel to loopback stays plain http.
	option cert '/etc/uhttpd.crt'
	option key '/etc/uhttpd.key'
	# Plain http to the https port from the house: '1' sends it to https on
	# the same port, '0' refuses it with a line saying to use https.
	option http_redirect '1'
	# /metrics and the Zabbix routes answer without a login on loopback only.
	# Set a long random token here to let a scraper in the house read them,
	# sending "Authorization: Bearer <token>". Empty, nothing from the house
	# side reads them. With https on (a house-side listen with the files
	# above), a scraper on the router itself uses https too:
	# https://127.0.0.1:8788/metrics, with uhttpd's self-signed certificate.
	option metrics_token ''
	# A soft limit on the service's memory, passed to the Go runtime as
	# GOMEMLIMIT: near it the collector works harder instead of the heap
	# growing; it never stops or kills the service. A whole number with B,
	# KiB, MiB or GiB; empty for no limit. Left out (or 'auto'), it follows
	# the router's RAM: 128MiB up to 768 MiB, 160MiB above, sized from the
	# Flint 2 and Beryl AX measurements (docs/flint2-measured.md section 6,
	# docs/small-router-memory-measured.md).
	#option memory_limit 'auto'
	# The console's data files. A missing one is not an error: without the
	# address table no country or organisation is shown, without the app map
	# every app is Unknown, without the vendor list no maker is named.
	option geo '/usr/share/netryx/ip2asn.pack'
	option apps '/usr/share/netryx/appmap.tsv'
	option oui '/usr/share/netryx/oui.pack'
	# Each app's brand colour and icon source. Most icons are built into the
	# console; this file says which brands have none and where to fetch theirs.
	option meta '/usr/share/netryx/apps-meta.json'
	# The page in your browser loads nothing from outside the router. For the
	# brands whose logo is not freely licensed, the router itself contacts each
	# brand's website once to fetch its icon (the site's favicon), keeps it in
	# the state directory and serves it from there; a site that fails is asked
	# again after a week. Set to 0 and the router contacts no brand's site:
	# those apps show a letter instead.
	option fetch_icons '1'
	# Where history (one small file an hour) and labels.json are kept.
	option state '/etc/netryx'
	# The ubus name of the internet interface; its IPv6 twin is read as wan6.
	option wan 'wan'
	# The internet tile's latency, jitter and loss come from one ping every
	# 10 s to the line's own gateway, so no third party is contacted. Set an
	# address or host name here to probe something on the internet instead.
	option ping_target ''
