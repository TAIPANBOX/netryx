config defaults
	option input 'REJECT'

config redirect
	option name 'Game console'
	option src 'wan'
	option src_dport '3074'
	option dest 'lan'
	option dest_ip '192.168.50.105'
	option proto 'udp'

config redirect 'nas'
	option name 'NAS web'
	option src 'wan'
	option src_dport '8443'
	option dest_ip '192.168.50.20'
	option dest_port '443'
	option enabled '0'

config redirect
	option name 'hairpin snat'
	option target 'SNAT'
	option src 'lan'
	option dest 'wan'
