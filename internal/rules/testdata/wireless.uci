config wifi-device 'radio0'
	option type 'mac80211'
	option band '2g'

config wifi-device 'radio1'
	option type 'mac80211'
	option band '5g'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'psk2'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Home'
	option encryption 'psk2'

config wifi-iface 'iot0'
	option device 'radio0'
	option network 'iot'
	option mode 'ap'
	option ssid 'Things'
	option isolate '1'

config wifi-iface 'iot1'
	option device 'radio1'
	option network 'iot'
	option mode 'ap'
	option ssid 'Things'
	option isolate '1'

config wifi-iface 'mixed0'
	option device 'radio0'
	option mode 'ap'
	option ssid 'Mixed'
	option isolate '1'

config wifi-iface 'mixed1'
	option device 'radio1'
	option mode 'ap'
	option ssid 'Mixed'
