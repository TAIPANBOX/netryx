# netryx rules, compiled by netryx, loaded with TZ=UTC nft -f
add table inet netryx_rules
add set inet netryx_rules cut_v4 { type ether_addr . ipv4_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules cut_v6 { type ether_addr . ipv6_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules isolated { type ether_addr; size 4096; }
add set inet netryx_rules approved { type ether_addr; size 10000; }
add set inet netryx_rules house_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet netryx_rules house_v6 { type ipv6_addr; flags interval; auto-merge; }
flush set inet netryx_rules isolated
flush set inet netryx_rules approved
add element inet netryx_rules approved { 02:4e:58:00:00:01, 02:4e:58:00:00:02 }
flush set inet netryx_rules house_v4
add element inet netryx_rules house_v4 { 192.168.50.0/24 }
flush set inet netryx_rules house_v6
add element inet netryx_rules house_v6 { fd21:b397:60f5::/48 }
add counter inet netryx_rules hits_iso
add chain inet netryx_rules rules_fwd { type filter hook forward priority -5; policy accept; }
add chain inet netryx_rules rules_dns { type nat hook prerouting priority dstnat - 5; policy accept; }
add chain inet netryx_rules rules_in { type filter hook input priority filter - 5; policy accept; }
add chain inet netryx_rules iso_in
add chain inet netryx_rules iso_fwd
flush chain inet netryx_rules rules_fwd
flush chain inet netryx_rules rules_dns
flush chain inet netryx_rules rules_in
flush chain inet netryx_rules iso_in
flush chain inet netryx_rules iso_fwd
add rule inet netryx_rules iso_in meta l4proto { tcp, udp } th dport { 53, 553 } return
add rule inet netryx_rules iso_in udp dport { 67, 123, 547 } return
add rule inet netryx_rules iso_in meta l4proto ipv6-icmp return
add rule inet netryx_rules iso_in ct state established,related return
add rule inet netryx_rules iso_in counter name hits_iso drop
add rule inet netryx_rules iso_fwd ip daddr @house_v4 counter name hits_iso drop
add rule inet netryx_rules iso_fwd ip6 daddr @house_v6 counter name hits_iso drop
add rule inet netryx_rules rules_in meta iiftype ether iifname { "br-lan" } ether saddr != @approved jump iso_in
add rule inet netryx_rules rules_fwd meta iiftype ether iifname { "br-lan" } ether saddr != @approved jump iso_fwd
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_v4 meta l4proto tcp reject with tcp reset
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_v4 reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_v6 meta l4proto tcp reject with tcp reset
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_v6 reject with icmpx admin-prohibited
add table bridge netryx_iso
add set bridge netryx_iso isolated { type ether_addr; size 4096; }
add set bridge netryx_iso approved { type ether_addr; size 10000; }
add counter bridge netryx_iso hits_iso
add chain bridge netryx_iso iso_fwd { type filter hook forward priority -5; policy accept; }
flush chain bridge netryx_iso iso_fwd
flush set bridge netryx_iso isolated
flush set bridge netryx_iso approved
add element bridge netryx_iso approved { 02:4e:58:00:00:01, 02:4e:58:00:00:02 }
add rule bridge netryx_iso iso_fwd meta ibrname { "br-lan" } ether saddr != @approved counter name hits_iso drop
