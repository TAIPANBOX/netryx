# netryx rules, compiled by netryx, loaded with TZ=UTC nft -f
add table inet netryx_rules
add set inet netryx_rules cc_ru_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet netryx_rules cc_ru_v6 { type ipv6_addr; flags interval; auto-merge; }
add set inet netryx_rules app_youtube_v4 { type ipv4_addr; flags timeout; timeout 24h; size 4096; }
add set inet netryx_rules app_youtube_v6 { type ipv6_addr; flags timeout; timeout 24h; size 4096; }
add set inet netryx_rules members_kidsyt { type ether_addr; flags timeout; }
add set inet netryx_rules members_pausetv { type ether_addr; flags timeout; }
add set inet netryx_rules allow_all { type ether_addr; flags timeout; }
add set inet netryx_rules allow_kidsyt { type ether_addr; flags timeout; }
add set inet netryx_rules cut_kidsyt_v4 { type ether_addr . ipv4_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules cut_kidsyt_v6 { type ether_addr . ipv6_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules cut_v4 { type ether_addr . ipv4_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules cut_v6 { type ether_addr . ipv6_addr . inet_proto . inet_service; flags timeout; timeout 10m; size 1024; }
add set inet netryx_rules isolated { type ether_addr; size 4096; }
add set inet netryx_rules approved { type ether_addr; size 10000; }
add set inet netryx_rules house_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet netryx_rules house_v6 { type ipv6_addr; flags interval; auto-merge; }
flush set inet netryx_rules cc_ru_v4
add element inet netryx_rules cc_ru_v4 { 5.8.0.0-5.8.255.255, 5.9.1.1 }
flush set inet netryx_rules cc_ru_v6
add element inet netryx_rules cc_ru_v6 { 2a00:1000::-2a00:100f:ffff:ffff:ffff:ffff:ffff:ffff }
flush set inet netryx_rules members_kidsyt
add element inet netryx_rules members_kidsyt { 02:4e:58:00:00:02 }
flush set inet netryx_rules members_pausetv
add element inet netryx_rules members_pausetv { 02:4e:58:00:00:01 }
flush set inet netryx_rules allow_all
add element inet netryx_rules allow_all { 02:4e:58:00:00:03 timeout 600s }
flush set inet netryx_rules allow_kidsyt
add element inet netryx_rules allow_kidsyt { 02:4e:58:00:00:02 timeout 1800s }
flush set inet netryx_rules isolated
flush set inet netryx_rules approved
flush set inet netryx_rules house_v4
add element inet netryx_rules house_v4 { 192.168.50.0/24 }
flush set inet netryx_rules house_v6
add element inet netryx_rules house_v6 { fd21:b397:60f5::/48 }
add counter inet netryx_rules hits_blockru
add counter inet netryx_rules hits_kidsyt
add counter inet netryx_rules hits_pausetv
add counter inet netryx_rules hits_iso
add chain inet netryx_rules rules_fwd { type filter hook forward priority -5; policy accept; }
add chain inet netryx_rules rules_dns { type nat hook prerouting priority dstnat - 5; policy accept; }
add chain inet netryx_rules rules_in { type filter hook input priority filter - 5; policy accept; }
add chain inet netryx_rules iso_in
add chain inet netryx_rules iso_fwd
add chain inet netryx_rules r_kidsyt
flush chain inet netryx_rules rules_fwd
flush chain inet netryx_rules rules_dns
flush chain inet netryx_rules rules_in
flush chain inet netryx_rules iso_in
flush chain inet netryx_rules iso_fwd
flush chain inet netryx_rules r_kidsyt
add rule inet netryx_rules iso_in meta l4proto { tcp, udp } th dport { 53, 553 } return
add rule inet netryx_rules iso_in udp dport { 67, 123, 547 } return
add rule inet netryx_rules iso_in meta l4proto ipv6-icmp return
add rule inet netryx_rules iso_in ct state established,related return
add rule inet netryx_rules iso_in counter name hits_iso drop
add rule inet netryx_rules iso_fwd ip daddr @house_v4 counter name hits_iso drop
add rule inet netryx_rules iso_fwd ip6 daddr @house_v6 counter name hits_iso drop
add rule inet netryx_rules rules_fwd ip daddr @cc_ru_v4 meta l4proto tcp counter name hits_blockru reject with tcp reset
add rule inet netryx_rules rules_fwd ip daddr @cc_ru_v4 counter name hits_blockru reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd ip6 daddr @cc_ru_v6 meta l4proto tcp counter name hits_blockru reject with tcp reset
add rule inet netryx_rules rules_fwd ip6 daddr @cc_ru_v6 counter name hits_blockru reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd ct status dnat ip saddr @cc_ru_v4 counter name hits_blockru drop
add rule inet netryx_rules rules_fwd ct status dnat ip6 saddr @cc_ru_v6 counter name hits_blockru drop
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_v4 meta l4proto tcp reject with tcp reset
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_v4 reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_v6 meta l4proto tcp reject with tcp reset
add rule inet netryx_rules rules_fwd meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_v6 reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd ether saddr @allow_all return
add rule inet netryx_rules rules_fwd ether saddr @members_pausetv meta l4proto tcp counter name hits_pausetv reject with tcp reset
add rule inet netryx_rules rules_fwd ether saddr @members_pausetv counter name hits_pausetv reject with icmpx admin-prohibited
add rule inet netryx_rules rules_fwd jump r_kidsyt
add rule inet netryx_rules r_kidsyt ether saddr @allow_kidsyt return
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt ip daddr @app_youtube_v4 meta l4proto tcp counter name hits_kidsyt reject with tcp reset
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt ip daddr @app_youtube_v4 counter name hits_kidsyt reject with icmpx admin-prohibited
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt ip6 daddr @app_youtube_v6 meta l4proto tcp counter name hits_kidsyt reject with tcp reset
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt ip6 daddr @app_youtube_v6 counter name hits_kidsyt reject with icmpx admin-prohibited
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_kidsyt_v4 meta l4proto tcp counter name hits_kidsyt reject with tcp reset
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt meta l4proto { tcp, udp } ether saddr . ip daddr . meta l4proto . th sport @cut_kidsyt_v4 counter name hits_kidsyt reject with icmpx admin-prohibited
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_kidsyt_v6 meta l4proto tcp counter name hits_kidsyt reject with tcp reset
add rule inet netryx_rules r_kidsyt ether saddr @members_kidsyt meta l4proto { tcp, udp } ether saddr . ip6 daddr . meta l4proto . th sport @cut_kidsyt_v6 counter name hits_kidsyt reject with icmpx admin-prohibited
add table bridge netryx_iso
add set bridge netryx_iso isolated { type ether_addr; size 4096; }
add set bridge netryx_iso approved { type ether_addr; size 10000; }
add counter bridge netryx_iso hits_iso
add chain bridge netryx_iso iso_fwd { type filter hook forward priority -5; policy accept; }
flush chain bridge netryx_iso iso_fwd
flush set bridge netryx_iso isolated
flush set bridge netryx_iso approved
